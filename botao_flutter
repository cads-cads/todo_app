
import 'package:flutter/material.dart';

class BotaoPersonalizado extends StatelessWidget {
  // Parâmetros do botão
  final String texto;
  final Color cor;
  final Color corTexto;
  final IconData? icone;
  final double tamanhoFonte;
  final double largura;
  final double altura;
  final double raioBorda;
  final VoidCallback onPressed;

  const BotaoPersonalizado({
    super.key,
    required this.texto,
    required this.onPressed,
    this.cor = Colors.blue,
    this.corTexto = Colors.white,
    this.icone,
    this.tamanhoFonte = 16,
    this.largura = 200,
    this.altura = 50,
    this.raioBorda = 10,
  });

  @override
  Widget build(BuildContext context) {
    return SizedBox(
      width: largura,
      height: altura,
      child: ElevatedButton(
        onPressed: onPressed,
        style: ElevatedButton.styleFrom(
          backgroundColor: cor,
          foregroundColor: corTexto,
          shape: RoundedRectangleBorder(
            borderRadius: BorderRadius.circular(raioBorda),
          ),
        ),
        child: Row(
          mainAxisAlignment: MainAxisAlignment.center,
          mainAxisSize: MainAxisSize.min,
          children: [
            if (icone != null) ...[
              Icon(icone),
              const SizedBox(width: 8),
            ],
            Flexible(
              child: Text(
                texto,
                overflow: TextOverflow.ellipsis,
                style: TextStyle(fontSize: tamanhoFonte),
              ),
            ),
          ],
        ),
      ),
    );
  }
}


