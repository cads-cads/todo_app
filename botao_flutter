import 'package:flutter/material.dart';

class BotaoConfirmacao extends StatelessWidget {
  // Texto e aparência do botão
  final String texto;
  final IconData? icone;
  final Color corBotao;
  final Color corTexto;
  final double largura;
  final double altura;
  final double raioBorda;

  // Conteúdo do AlertDialog
  final String titulo;
  final String mensagem;
  final IconData? iconeAlerta;
  final Color corIconeAlerta;

  // Textos das ações
  final String textoConfirmar;
  final String textoCancelar;

  // Aparência das ações
  final Color? corConfirmar;
  final Color? corCancelar;

  // Comportamento
  final VoidCallback onConfirmar;
  final VoidCallback? onCancelar;

  const BotaoConfirmacao({
    super.key,
    required this.texto,
    required this.titulo,
    required this.mensagem,
    required this.onConfirmar,
    this.icone,
    this.corBotao = Colors.blue,
    this.corTexto = Colors.white,
    this.largura = 220,
    this.altura = 50,
    this.raioBorda = 12,
    this.iconeAlerta = Icons.help_outline,
    this.corIconeAlerta = Colors.orange,
    this.textoConfirmar = 'Confirmar',
    this.textoCancelar = 'Cancelar',
    this.corConfirmar,
    this.corCancelar,
    this.onCancelar,
  });

  Future<void> _mostrarDialog(BuildContext context) async {
    final bool? confirmou = await showDialog<bool>(
      context: context,
      builder: (dialogContext) {
        return AlertDialog(
          icon: iconeAlerta != null
              ? Icon(
                  iconeAlerta,
                  color: corIconeAlerta,
                  size: 36,
                )
              : null,
          title: Text(titulo),
          content: Text(mensagem),
          actions: [
            TextButton(
              onPressed: () {
                Navigator.of(dialogContext).pop(false);
              },
              child: Text(
                textoCancelar,
                style: TextStyle(
                  color: corCancelar,
                ),
              ),
            ),
            FilledButton(
              onPressed: () {
                Navigator.of(dialogContext).pop(true);
              },
              style: FilledButton.styleFrom(
                backgroundColor: corConfirmar,
              ),
              child: Text(textoConfirmar),
            ),
          ],
        );
      },
    );

    if (!context.mounted) return;

    if (confirmou == true) {
      onConfirmar();
    } else {
      onCancelar?.call();
    }
  }

  @override
  Widget build(BuildContext context) {
    return SizedBox(
      width: largura,
      height: altura,
      child: ElevatedButton(
        onPressed: () => _mostrarDialog(context),
        style: ElevatedButton.styleFrom(
          backgroundColor: corBotao,
          foregroundColor: corTexto,
          shape: RoundedRectangleBorder(
            borderRadius: BorderRadius.circular(raioBorda),
          ),
        ),
        child: Row(
          mainAxisAlignment: MainAxisAlignment.center,
          mainAxisSize: MainAxisSize.min,
          children: [
            if (icone != null) ...[
              Icon(icone),
              const SizedBox(width: 8),
            ],
            Flexible(
              child: Text(
                texto,
                overflow: TextOverflow.ellipsis,
              ),
            ),
          ],
        ),
      ),
    );
  }
}



